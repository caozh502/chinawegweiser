---
/**
 * FAQ-Block als Akkordeon: jeder Punkt ist ein natives <details>,
 * standardmäßig zu, ein Klick öffnet die Antwort.
 * Nativ heißt: funktioniert ohne JavaScript, ist per Tastatur bedienbar
 * und der Text bleibt im HTML – Google liest ihn trotzdem (FAQPage-Markup
 * im Layout muss zum sichtbaren Inhalt passen, das tut es hier weiterhin).
 */
interface Props {
  items: { q: string; a: string }[];
  id?: string;
  title?: string;
}
const { items, id = 'haeufige-fragen', title = 'Häufige Fragen' } = Astro.props;
---

{
  items.length > 0 && (
    <>
      <h2 id={id}>{title}</h2>
      <div class="faq">
        {items.map((f) => (
          <details class="faq-item" name="faq">
            <summary class="faq-q">
              <span>{f.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </>
  )
}

<style>
  .faq {
    margin: 0 0 1.4rem;
    border-bottom: 1px solid var(--line);
  }
  .faq-item {
    border-top: 1px solid var(--line);
  }
  .faq-q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 0.97rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--fg);
  }
  /* Standard-Dreieck der Browser ausblenden */
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q::marker {
    content: '';
  }
  .faq-q:hover {
    color: var(--accent);
  }
  .faq-q:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Plus aus zwei Balken: ein SVG ließe sich hier zwar auch drehen, aber
     Chrome berechnet Transform bei SVG-Kindern unzuverlässig – ein
     HTML-Element ist der robustere Weg. */
  .faq-icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 0.2rem;
    /* Bewusst ohne Transition: Chrome führt Übergänge in einem zuvor
       geschlossenen <details> nicht zu Ende (Symbol bleibt auf „+"). */
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    border-radius: 1px;
  }
  .faq-icon::before {
    left: 0;
    top: 6.25px;
    width: 14px;
    height: 1.5px;
  }
  .faq-icon::after {
    top: 0;
    left: 6.25px;
    width: 1.5px;
    height: 14px;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-a {
    margin: 0;
    padding: 0 0 1rem;
    max-width: 62ch;
    color: var(--fg);
  }
  @media (max-width: 34rem) {
    .faq-q {
      font-size: 0.94rem;
    }
  }
</style>
