---
/**
 * Einzeiliger Partner-Hinweis für Stellen, an denen ein ganzer Kasten zu viel wäre
 * (Startseite, Tabellen, Zwischenüberschriften). Kennzeichnung „Anzeige" ist Pflicht.
 */
import { affiliates } from '../data/affiliates';

interface Props {
  /** Nicht `slot` nennen – das ist in Astro reserviert. */
  name: string;
  prefix?: string;
  /** Stadt-Slug, um ein stadtspezifisches Ziel zu wählen. */
  city?: string;
}

const { name, prefix, city } = Astro.props;
const a = affiliates[name];
const target = (city && a?.urls?.[city]) || a?.url;
---

{a && (
  <p class="aff-inline">
    <span class="aff-badge">Anzeige</span>
    {prefix ?? a.title}:
    <a href={target} target="_blank" rel="sponsored nofollow noopener">{a.cta} →</a>
  </p>
)}
