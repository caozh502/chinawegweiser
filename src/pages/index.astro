---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CityTeaser from '../components/CityTeaser.astro';
// AffiliateInline wird hier nicht mehr verwendet – die Zeile lenkte mitten im Fluss ab.
import { getCollection } from 'astro:content';
import '../styles/home.css';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const städte = await getCollection('cities');

const cityNames: Record<string, string> = {
  system: 'Praktisches',
  peking: 'Peking',
  shanghai: 'Shanghai',
  xian: "Xi'an",
  chengdu: 'Chengdu',
  guilin: 'Guilin',
};

const cityOrder = ['system', 'peking', 'shanghai', 'xian', 'chengdu', 'guilin'];

const grouped = cityOrder
  .map((city) => ({ city, items: guides.filter((g) => g.data.city === city) }))
  .filter((g) => g.items.length > 0);

/** Fertige Stadtführer – Reihenfolge wie im Menü. */
const fertigeStaedte = städte.sort(
  (a, b) => cityOrder.indexOf(a.data.city) - cityOrder.indexOf(b.data.city)
);

/** Startseiten-Hero. */
const hero = {
  file: 'peking/hero-jingshan.jpg',
  alt: 'Blick vom Jingshan-Park über die Dächer der Verbotenen Stadt',
  caption: 'Peking, vom Jingshan-Park nach Süden: die Achse, an der sich fast jede Route entscheidet.',
  author: 'Tojan76',
  license: 'CC BY-SA 3.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/3.0',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Forbidden_City_Panorama_3.jpg',
};

/** Schritt 1 nach dem Hero: die zwei Fragen, die vor dem Abflug geklärt sein müssen. */
const vorabflug = [
  {
    no: '01',
    title: 'Einreise ohne Visum',
    answer:
      '30 Tage visumfrei mit deutschem Pass – aber mit Rückflugticket, Unterkunft und einer Adresse, die an der Grenze abgefragt werden kann.',
    href: '/system/visumfrei-china-30-tage/',
    meta: 'geprüft',
  },
  {
    no: '02',
    title: 'Internet ab der Landung',
    answer:
      'Deutsche SIM-Karten funktionieren, aber Google, WhatsApp und vieles andere laufen nur über einen Zugang, der vorher eingerichtet ist.',
    href: '/system/internet-esim/',
    meta: 'geprüft',
  },
];

/** Teaser-Bild je Stadt; fehlt es, nimmt CityTeaser das erste Sehenswürdigkeitsfoto. */
const teaserBild: Record<string, any> = {
  peking: {
    file: 'peking/gugong-supreme.jpg',
    alt: 'Halle der höchsten Harmonie in der Verbotenen Stadt',
    caption: 'Halle der höchsten Harmonie',
    author: 'Perry Li',
    license: 'CC BY-SA 2.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/2.0',
    sourceUrl:
      'https://commons.wikimedia.org/wiki/File:2015-03-15_Hall_of_Supreme_Harmony_(Forbidden_City).jpg',
  },
};
---

<Base
  title="China Wegweiser – der praktische Reiseführer für deutsche China-Reisende"
  description="Alles, was auf einer China-Reise schiefgeht – Einreise, Bezahlen, Tickets, Internet, Transport – an einem Ort, mit Datum der letzten Prüfung."
>
  <section class="home-hero">
    <div class="eyebrow">China · unabhängig · Stand 29.10.2026</div>
    <h1>China ohne Umwege</h1>
    <p class="lead">
      Wir sind eine kleine Gruppe von Reisenden: in China aufgewachsen, seit vielen Jahren in
      Deutschland zu Hause. Wir kennen beide Seiten – wie sich China anfühlt und welche Frage sich
      ein deutscher Reisender dort stellt.
    </p>
    <p class="lead lead-2">
      Reiseinfos über China veralten schnell: Apps, Ticketportale, Einreiseregeln ändern sich
      mehrmals im Jahr. Deshalb gilt hier:
    </p>
    <ul class="hero-points">
      <li>
        <strong>Aktuell, mit Datum.</strong> Jede Seite trägt den Tag der letzten Prüfung.
      </li>
      <li>
        <strong>Keine „Top 10“-Listen.</strong> Jeder Ort ist ausgewählt, viele selbst besucht.
      </li>
      <li>
        <strong>Für Reisende aus Deutschland</strong> – in der Reihenfolge, in der man es braucht.
      </li>
    </ul>
    <div class="hero-actions">
      <a class="btn-primary" href="/praktisch/">Was vor dem Abflug zählt →</a>
      <a class="btn-quiet" href="/stadt/peking/">Schon entschieden: direkt nach Peking</a>
    </div>

    <Photo photo={hero} loading="eager" class="home-hero-photo" />
  </section>

  <section class="preflight">
    <div class="section-h">
      <h2>Zwei Dinge, die vor dem Abflug stehen müssen</h2>
      <span>alles andere lässt sich vor Ort lösen</span>
    </div>
    <div class="preflight-grid">
      {vorabflug.map((v) => (
        <a class="preflight-card" href={v.href}>
          <span class="p-no">{v.no}</span>
          <span class="p-body">
            <span class="p-title">{v.title}</span>
            <span class="p-answer">{v.answer}</span>
            <span class="p-meta">{v.meta} · zur Seite →</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  {fertigeStaedte.map((stadt) => (
    <CityTeaser
      entry={stadt}
      name={cityNames[stadt.data.city] ?? stadt.data.city}
      photo={teaserBild[stadt.data.city]}
    />
  ))}

  <ul class="trust-strip">
    <li>Chinesische Quellen im Original</li>
    <li>Jede Seite mit Prüfdatum</li>
    <li>Anzeigen gekennzeichnet</li>
    <li>Kostenlos, ohne Konto</li>
  </ul>

  {/* Der Index erscheint erst, wenn es mehr Seiten gibt, als oben schon verlinkt sind. */}
  {grouped.filter((g) => g.items.length > 2).map(({ city, items }) => (
    <section>
      <div class="section-h">
        <h2>Alle Seiten: {cityNames[city] ?? city}</h2>
        <span>{items.length} Seiten</span>
      </div>
      <div class="grid">
        {items.map((g) => (
          <a class="card" href={`/${g.id}/`}>
            <div class="t">{g.data.title}</div>
            <div class="c">{g.data.status === 'verified' ? 'geprüft' : 'Entwurf'}</div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="soon">
    <div class="section-h">
      <h2>In Arbeit</h2>
      <span>Reihenfolge nach Nachfrage</span>
    </div>
    <ul class="soon-list">
      <li><b>Shanghai</b> – Bund, Yu-Garten, Disney, Suzhou als Tagesausflug</li>
      <li><b>Xi'an</b> – Terrakotta-Armee, Stadtmauer, Muslim Quarter</li>
      <li><b>Chengdu</b> – Pandabasis, Teehäuser, Leshan</li>
      <li><b>Guilin</b> – Li-Fluss, Yangshuo, Longji-Reisterrassen</li>
    </ul>
  </section>

  <section>
    <div class="section-h">
      <h2>Wie diese Seite funktioniert</h2>
    </div>
    <p class="prose-sm">
      Jede Seite trägt ein Datum. <strong>„Geprüft"</strong> heißt: an einer offiziellen Quelle
      oder vor Ort kontrolliert. <strong>„Recherchiert"</strong> heißt: zusammengetragen, aber noch
      nicht gegengeprüft – das steht dann auch so auf der Seite. Wenn etwas nicht mehr stimmt,
      <a href="/transparenz/">melde es uns</a>. Wer dahintersteht, steht
      <a href="/autoren/">hier</a>, warum es diese Seite gibt, <a href="/warum/">hier</a>.
    </p>
  </section>
</Base>
