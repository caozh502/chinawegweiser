---
import Base from './Base.astro';
import { site, contactEmail } from '../data/site';
import AffiliateBox from '../components/AffiliateBox.astro';
import Toc from '../components/Toc.astro';
import Photo from '../components/Photo.astro';
import { slugify } from '../lib/rehype-heading-ids.mjs';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'guides'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const statusText: Record<string, string> = {
  verified: 'Vor Ort geprüft',
  draft: 'Nicht vor Ort geprüft',
  stale: 'Prüfung überfällig',
};

const fmt = (iso?: string) =>
  iso
    ? new Date(`${iso}T12:00:00Z`).toLocaleDateString('de-DE', {
        day: '2-digit',
        month: 'long',
        year: 'numeric',
      })
    : null;

const cityNames: Record<string, string> = {
  system: 'Praktisches',
  peking: 'Peking',
  shanghai: 'Shanghai',
  xian: "Xi'an",
  chengdu: 'Chengdu',
  guilin: 'Guilin',
};

const cityName = cityNames[d.city] ?? d.city;
const verifiedText = fmt(d.verified);

/** Strukturierte Daten für die Fragen-Seiten (Ratgeber-Format). */
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  inLanguage: 'de',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  image: [new URL('/og-default.jpg', Astro.site).toString()],
  author: {
    '@type': 'Person',
    name: site.owner.name,
    url: new URL('/autoren/', Astro.site).toString(),
  },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  isAccessibleForFree: true,
  ...(d.verified ? { dateModified: `${d.verified}T12:00:00+01:00` } : {}),
};
const mailSubject = encodeURIComponent(`Korrektur: ${d.title}`);

/* Inhaltsverzeichnis aus den Markdown-Überschriften (IDs setzt
   src/lib/rehype-heading-ids.mjs) plus die datengetriebenen Blöcke. */
const mdSections = [...(entry.body ?? '').matchAll(/^##\s+(.+)$/gm)].map((m) => {
  const t = m[1].trim();
  return { title: t, id: slugify(t) };
});

const toc = [
  ...mdSections,
  ...(d.chinese ? [{ title: 'Zum Vorzeigen', id: 'cn-card' }] : []),
  ...(d.affiliate.length > 0 ? [{ title: 'Buchen', id: 'buchen' }] : []),
  ...(d.sources.length > 0 ? [{ title: 'Quellen', id: 'quellen' }] : []),
  ...(d.faq.length > 0 ? [{ title: 'Häufige Fragen', id: 'haeufige-fragen' }] : []),
];

/* Lesezeit: grob 200 Wörter pro Minute. */
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));

const faqLd = d.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<Base title={d.title} description={d.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  </Fragment>
  <article class="entry">
    <div class="eyebrow">
      <a href={d.city === 'system' ? '/praktisch/' : `/stadt/${d.city}/`}>{cityName}</a> ·
      {d.category}
    </div>
    <h1>{d.title}</h1>

    <div class="metabar">
      <span class="byline">Von <a href="/autoren/">{site.owner.name}</a></span>
      <span class="metafacts">
        <span class={`statusword ${d.status}`}
          ><span class={`dot ${d.status}`} aria-hidden="true"></span>{statusText[d.status]}</span
        >
        {verifiedText && <span>Stand {verifiedText}</span>}
        {d.duration && <span>{d.duration}</span>}
        <span>{readingTime} Min. Lesezeit</span>
      </span>
    </div>

    <div class="answer">
      <strong>Kurz gesagt</strong>
      <p>{d.answer}</p>
    </div>

    {d.hero && <Photo photo={d.hero} loading="eager" class="hero-photo" />}

    <div class="guide-shell">
      <Toc items={toc} />
      <div class="guide-body">
    <Content />

    {d.chinese && (
      <div class="cn-card" id="cn-card">
        <div class="label">Zum Vorzeigen (中文)</div>
        <div class="cn">
          {d.chinese.name}
          <span class="addr">{d.chinese.address}</span>
        </div>
        {d.chinese.note && <div class="note">{d.chinese.note}</div>}
        <button
          type="button"
          data-copy={`${d.chinese.name}\n${d.chinese.address}`}
          >Chinesisch kopieren</button
        >
      </div>
    )}

    <div id="buchen">{d.affiliate.map((slot) => <AffiliateBox name={slot} />)}</div>

    {d.sources.length > 0 && (
      <div class="sources">
        <h2 style="margin-top:2rem" id="quellen">Quellen</h2>
        <ul>
          {d.sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener nofollow">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {d.faq.length > 0 && (
      <>
        <h2 id="haeufige-fragen">Häufige Fragen</h2>
        {d.faq.map((f) => (
          <div>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </>
    )}

      </div>
    </div>

    <div class="report">
      <p>
        <strong>Etwas stimmt nicht mehr?</strong> Preise, Öffnungszeiten und Reservierungsregeln
        ändern sich in China schnell. Schreib uns eine Zeile – wir prüfen es und aktualisieren die
        Seite.
      </p>
      <a href={`mailto:${contactEmail}?subject=${mailSubject}`}>Korrektur melden →</a>
    </div>

    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </article>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cn-card button[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'Kopiert ✓';
        btn.dataset.done = '1';
        setTimeout(() => {
          btn.textContent = original;
          delete btn.dataset.done;
        }, 2000);
      } catch {
        btn.textContent = 'Kopieren nicht möglich';
      }
    });
  });
</script>
