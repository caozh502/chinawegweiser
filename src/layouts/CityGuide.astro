---
import Base from './Base.astro';
import { site, contactEmail } from '../data/site';
import Photo from '../components/Photo.astro';
import SightMap from '../components/SightMap.astro';
import Toc from '../components/Toc.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import AffiliateInline from '../components/AffiliateInline.astro';
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { slugify } from '../lib/rehype-heading-ids.mjs';
import '../styles/city.css';

interface Props {
  entry: CollectionEntry<'cities'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const subpages = (await getCollection('guides'))
  .filter((g) => g.data.city === d.city)
  .sort((a, b) => a.data.order - b.data.order);

const statusText: Record<string, string> = {
  verified: 'Verifiziert',
  draft: 'Entwurf – nicht vor Ort geprüft',
  stale: 'Prüfung überfällig',
};
const bookingLabel: Record<string, string> = {
  required: 'Reservierung nötig',
  recommended: 'Reservierung empfohlen',
  none: 'ohne Reservierung',
};

const fmt = (iso?: string) =>
  iso
    ? new Date(`${iso}T12:00:00Z`).toLocaleDateString('de-DE', {
        day: '2-digit',
        month: 'long',
        year: 'numeric',
      })
    : null;
const verifiedText = fmt(d.verified);

/* Lesezeit: rund 200 Wörter pro Minute, Markdown-Text plus Datenblöcke. */
const readingTime = Math.max(
  3,
  Math.round(((entry.body ?? '').split(/\s+/).filter(Boolean).length + 600) / 200)
);

const sightName = (no: number) => d.sights.find((s) => s.no === no)?.name ?? String(no);
/** Pflicht und Kür getrennt: die Kür braucht keine Videokarte und keine Tariftabelle. */
const mustSights = d.sights.filter((s) => s.tier === 'must');
const optSights = d.sights.filter((s) => s.tier === 'optional');

/* Inhaltsverzeichnis: Abschnitte aus dem Markdown plus die datengetriebenen
   Blöcke weiter unten. Die IDs der Markdown-Überschriften setzt
   src/lib/rehype-heading-ids.mjs mit derselben slugify-Funktion. */
const mdSections = [...(entry.body ?? '').matchAll(/^##\s+(.+)$/gm)].map((m) => {
  const title = m[1].trim();
  return { title, id: slugify(title) };
});

const toc = [
  ...mdSections,
  ...(d.connections.length > 0 ? [{ title: 'Anreise', id: 'anreise' }] : []),
  ...(d.areas.length > 0 ? [{ title: 'Wo wohnen', id: 'wohnen' }] : []),
  ...(d.sights.length > 0 ? [{ title: 'Sehenswürdigkeiten', id: 'sehenswuerdigkeiten' }] : []),
  ...(d.sights.length > 0 ? [{ title: 'Pflichtprogramm', id: 'pflichtprogramm', sub: true }] : []),
  ...(optSights.length > 0 ? [{ title: 'Wenn noch Zeit ist', id: 'weitere', sub: true }] : []),
  ...(d.plans.length > 0 ? [{ title: 'Routen', id: 'routen' }] : []),
  ...(d.experiences.length > 0 ? [{ title: 'Erlebnisse', id: 'erlebnisse' }] : []),
  ...(d.bookAhead.length > 0 ? [{ title: 'Vorher buchen', id: 'buchen' }] : []),
  ...(d.traps.length > 0 ? [{ title: 'Typische Fehler', id: 'fehler' }] : []),
  ...(subpages.length > 0 ? [{ title: 'Detailseiten', id: 'detailseiten' }] : []),
  ...(d.changelog.length > 0 ? [{ title: 'Aktualisierungen', id: 'changelog' }] : []),
  ...(d.sources.length > 0 ? [{ title: 'Quellen', id: 'quellen' }] : []),
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Sehenswürdigkeiten ${d.city}`,
  itemListElement: d.sights.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'TouristAttraction',
      name: s.name,
      ...(s.lat && s.lng
        ? { geo: { '@type': 'GeoCoordinates', latitude: s.lat, longitude: s.lng } }
        : {}),
    },
  })),
};
---

<Base title={d.title} description={d.description}>
  <article class="entry">
    <div class="eyebrow"><a href="/">Start</a> · Stadt</div>
    <h1>{d.title}</h1>

    <div class="metabar">
      <span class="byline">Von <a href="/autoren/">{site.owner.name}</a></span>
      <span class={`badge ${d.status}`}>{statusText[d.status]}</span>
      {verifiedText && (
        <span class="badge"
          >{d.status === 'verified' ? 'Geprüft' : 'Recherchiert'}: {verifiedText}</span
        >
      )}
      {d.days && <span class="badge">{d.days}</span>}
      <span class="badge">{readingTime} Min. Lesezeit</span>
    </div>

    <p class="lead">{d.intro}</p>

    <Photo photo={d.hero} loading="eager" class="hero-photo" />

    <section class="steckbrief">
      <div><span class="k">Zeit vor Ort</span><span class="v">{d.days}</span></div>
      {d.season && <div><span class="k">Beste Zeit</span><span class="v">{d.season}</span></div>}
      {d.budget && <div><span class="k">Budget / Tag</span><span class="v">{d.budget}</span></div>}
      {d.base && <div><span class="k">Basis</span><span class="v">{d.base}</span></div>}
    </section>

    <div class="guide-shell">
      <Toc items={toc} />
      <div class="guide-body">
    <Content />

    {d.connections.length > 0 && (
      <>
        <h2 id="anreise">Anreise</h2>
        <table>
          <thead>
            <tr><th>Weg</th><th>Dauer</th><th>Preis</th><th>Hinweis</th></tr>
          </thead>
          <tbody>
            {d.connections.map((c) => (
              <tr>
                <td>{c.mode}</td>
                <td>{c.time}</td>
                <td>{c.price ?? '–'}</td>
                <td>{c.note ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <AffiliateBox name="train" />
      </>
    )}

    {d.areas.length > 0 && (
      <>
        <h2 id="wohnen">Wo wohnen</h2>
        <div class="areas">
          {d.areas.map((a) => (
            <div class="area">
              <h3>{a.name}</h3>
              {a.pro && <p class="pro">+ {a.pro}</p>}
              {a.con && <p class="con">− {a.con}</p>}
              <ul class="hotels">
                {a.hotels.map((h) => (
                  <li>
                    <span class="h-name">{h.name}</span>
                    <span class="h-meta">
                      {h.stars ? `${h.stars}★` : ''}
                      {h.rating ? ` · ${h.rating.toFixed(1)}` : ''}
                      {h.reviews ? ` (${h.reviews})` : ''}
                    </span>
                    {h.note && <span class="h-note">{h.note}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <AffiliateBox name="hotels" />
      </>
    )}

    {d.sights.length > 0 && (
      <>
        <h2 id="sehenswuerdigkeiten">Sehenswürdigkeiten</h2>
        <p class="sources" style="margin-top:-.4rem">
          Nummern gelten für Karte und Routen weiter unten.
        </p>

        <SightMap sights={d.sights} areas={d.areas} city={d.city} />

        <div class="sights">
        {mustSights.length > 0 && (
          <h3 class="sights-sub is-first" id="pflichtprogramm">
            Pflichtprogramm{' '}<span class="sub-count">{mustSights.length} Orte</span>
          </h3>
        )}
          {mustSights.map((s) => (
            <div class="sight" id={`s${s.no}`}>
              <div class="s-head">
                <span class="num">{s.no}</span>
                <div>
                  <div class="s-name">{s.name}</div>
                  {(s.pinyin || s.german) && (
                    <div class="s-de">{[s.pinyin, s.german].filter(Boolean).join(' · ')}</div>
                  )}
                </div>
                {typeof s.lat === 'number' && (
                  <button type="button" class="zoom-link" data-zoom-sight={s.no}>
                    Auf Karte
                  </button>
                )}
              </div>
              <div class="s-meta">
                {s.price && <span class="chip">{s.price}</span>}
                {s.duration && <span class="chip">{s.duration}</span>}
                <span class={`chip book-${s.booking}`}>{bookingLabel[s.booking]}</span>
              </div>
              {s.note && <p class="s-note">{s.note}</p>}

              {(s.hours || s.closed || s.transit || s.official || s.buyTickets) && (
                <dl class="s-facts">
                  {s.hours && (<><dt>Öffnungszeiten</dt><dd>{s.hours}</dd></>)}
                  {s.closed && (<><dt>Geschlossen</dt><dd>{s.closed}</dd></>)}
                  {s.transit && (<><dt>Eingang</dt><dd>{s.transit}</dd></>)}
                  {s.nearby && (<><dt>In der Nähe</dt><dd>{s.nearby}</dd></>)}
                  {s.buyTickets && (
                    <>
                      <dt>Tickets</dt>
                      <dd>
                        <strong>{s.buyTickets}</strong>
                        {s.buyTicketsAlt && <> {s.buyTicketsAlt}</>}
                        {s.ticketUrl && (
                          <>
                            {' '}
                            <a class="s-ext" href={s.ticketUrl} target="_blank" rel="noopener noreferrer">
                              Ticketseite ↗
                            </a>
                          </>
                        )}
                      </dd>
                    </>
                  )}
                  {s.official && (
                    <>
                      <dt>Website</dt>
                      <dd>
                        <a class="s-ext" href={s.official.url} target="_blank" rel="noopener noreferrer">
                          {s.official.label} ↗
                        </a>
                      </dd>
                    </>
                  )}
                </dl>
              )}

              {s.tickets.length > 0 && (
                <ul class="s-tickets">
                  {s.tickets.map((t) => (
                    <li>
                      <span class="t-row">
                        <span class="t-label">{t.label}</span>
                        <span class="t-fill" aria-hidden="true"></span>
                        <span class="t-price">{t.price}</span>
                      </span>
                      {t.note && <span class="t-note">{t.note}</span>}
                    </li>
                  ))}
                </ul>
              )}

              {(() => {
                const alle = s.photo ? [s.photo, ...s.photos] : s.photos;
                if (alle.length === 0) return null;
                return (
                  <div class={`s-gallery${alle.length === 1 ? ' single' : ''}`}>
                    {alle.map((p) => <Photo photo={p} />)}
                  </div>
                );
              })()}

              {s.video && (
                <div class="s-video">
                  <button
                    type="button"
                    class="v-thumb"
                    data-play={s.video.id}
                    aria-label={`Video abspielen: ${s.video.title}`}
                  >
                    <img
                      src={`https://i.ytimg.com/vi/${s.video.id}/hqdefault.jpg`}
                      alt=""
                      width="480"
                      height="360"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                    <span class="v-play" aria-hidden="true"></span>
                  </button>
                  <div class="v-meta">
                    <span class="v-kicker">Video · {s.video.lang === 'de' ? 'Deutsch' : 'Englisch'}</span>
                    <a
                      class="v-title"
                      href={`https://www.youtube.com/watch?v=${s.video.id}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >{s.video.title}</a>
                    <span class="v-sub">{s.video.channel}</span>
                    <a
                      class="v-open"
                      href={`https://www.youtube.com/watch?v=${s.video.id}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >Auf YouTube öffnen ↗</a>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>

        {optSights.length > 0 && (
          <>
            <h3 class="sights-sub" id="weitere">
              Wenn noch Zeit ist{' '}<span class="sub-count">{optSights.length} Orte</span>
            </h3>
            <p class="sources sub">
              Kurzfassung statt Datenblatt – diese Orte lohnen sich, wenn der Tag Luft hat.
            </p>
            <ul class="sight-list">
              {optSights.map((s) => (
                <li class="sight-mini" id={`s${s.no}`}>
                  <div class="m-text">
                    <div class="m-head">
                      <span class="num">{s.no}</span>
                      <span class="m-title">
                        <span class="s-name">{s.name}</span>
                        {(s.pinyin || s.german) && (
                          <span class="s-de">{[s.pinyin, s.german].filter(Boolean).join(' · ')}</span>
                        )}
                      </span>
                      {typeof s.lat === 'number' && (
                        <button type="button" class="zoom-link" data-zoom-sight={s.no}>
                          Auf Karte
                        </button>
                      )}
                    </div>
                    <div class="s-meta">
                      {s.price && <span class="chip">{s.price}</span>}
                      {s.duration && <span class="chip">{s.duration}</span>}
                      <span class={`chip book-${s.booking}`}>{bookingLabel[s.booking]}</span>
                    </div>
                    {s.warn && <p class="warn-line">{s.warn}</p>}
                    {s.note && <p class="s-note">{s.note}</p>}
                    {s.nearby && <p class="near-line">{s.nearby}</p>}
                    {(s.hours || s.closed || s.transit) && (
                      <dl class="m-facts">
                        {s.hours && (<><dt>Geöffnet</dt><dd>{s.hours}</dd></>)}
                        {s.closed && (<><dt>Geschlossen</dt><dd>{s.closed}</dd></>)}
                        {s.transit && (<><dt>Eingang</dt><dd>{s.transit}</dd></>)}
                      </dl>
                    )}
                  </div>
                  {s.photo && (
                    <div class="m-photo">
                      <Photo photo={s.photo} />
                      {s.photos.map((p) => <Photo photo={p} />)}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </>
        )}
      </>
    )}

    {d.plans.length > 0 && (
      <>
        <h2 id="routen">Routen</h2>
        <p class="sources" style="margin-top:-.4rem">
          Die Zahlen sind die Nummern der Sehenswürdigkeiten oben.
        </p>
        <div class="plans">
          {d.plans.map((p) => (
            <div class="plan">
              <div class="p-head">
                <h3>{p.title}</h3>
                {p.forWhom && <span class="p-for">{p.forWhom}</span>}
              </div>
              <ol>
                {p.days.map((day) => (
                  <li>
                    <span class="d-label">Tag {day.day}</span>
                    <div class="d-body">
                      <span class="d-chips">
                        {day.sights.length === 0 ? (
                          <span class="chip chip-empty" aria-hidden="true">—</span>
                        ) : (
                          day.sights.map((no) => (
                            <a class="chip num-chip" href={`#s${no}`} title={sightName(no)}>
                              {no}
                            </a>
                          ))
                        )}
                      </span>
                      {(day.morning || day.afternoon || day.evening) && (
                        <dl class="d-slots">
                          {day.morning && (<><dt>Morgen</dt><dd>{day.morning}</dd></>)}
                          {day.afternoon && (<><dt>Nachmittag</dt><dd>{day.afternoon}</dd></>)}
                          {day.evening && (<><dt>Abend</dt><dd>{day.evening}</dd></>)}
                        </dl>
                      )}
                      {day.note && <span class="d-note">{day.note}</span>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </>
    )}

    {(d.bookAhead.length > 0 || d.traps.length > 0) && (
      <div class="two-col">
        {d.bookAhead.length > 0 && (
          <div id="buchen">
            <h2>Vorher buchen</h2>
            <ul class="check">
              {d.bookAhead.map((b) => <li>{b}</li>)}
            </ul>
            <AffiliateInline name="tours" prefix="Wenn das Reservierungssystem klemmt" />
          </div>
        )}
        {d.traps.length > 0 && (
          <div id="fehler">
            <h2>Typische Fehler</h2>
            <ul class="traps">
              {d.traps.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        )}
      </div>
    )}

    {d.bookAhead.length > 0 && (
      <div class="aff-pair">
        <AffiliateBox name="esim" />
        <AffiliateBox name="insurance" />
      </div>
    )}

    {d.experiences.length > 0 && (
      <>
        <h2 id="erlebnisse">Erlebnisse</h2>
        <p class="sources" style="margin-top:-.4rem">
          Drei Dinge, die man in Peking tut und nicht nur ansieht – mit Preisen und dem, was
          schiefgehen kann.
        </p>
        <div class="exp-list">
          {d.experiences.map((e) => (
            <article class="exp">
              <div class="e-text">
                <div class="e-head">
                  <h3>{e.german}</h3>
                  {e.name && (
                    <span class="e-name">
                      {e.name}
                      {e.pinyin ? ` · ${e.pinyin}` : ''}
                    </span>
                  )}
                </div>
                <div class="e-meta">
                  {e.when && <span class="chip">{e.when}</span>}
                  {e.price && <span class="chip">{e.price}</span>}
                </div>
                <p class="e-body">{e.text}</p>
                {e.steps.length > 0 && (
                  <ol class="e-steps">
                    {e.steps.map((st) => <li>{st}</li>)}
                  </ol>
                )}
                {e.tip && <p class="e-tip">{e.tip}</p>}
              </div>
              {e.photo && <div class="e-photo"><Photo photo={e.photo} /></div>}
            </article>
          ))}
        </div>
      </>
    )}

    {subpages.length > 0 && (
      <>
        <h2 id="detailseiten">Detailseiten</h2>
        <div class="grid">
          {subpages.map((g) => (
            <a class="card" href={`/${g.id}/`}>
              <div class="t">{g.data.title}</div>
              <div class="c">{g.data.category}</div>
            </a>
          ))}
        </div>
      </>
    )}

    {d.changelog.length > 0 && (
      <>
        <h2 id="changelog">Aktualisierungen</h2>
        <ul class="changelog">
          {d.changelog.map((c) => (
            <li>
              <time datetime={c.date}>{fmt(c.date)}</time>
              <span>{c.text}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    {d.sources.length > 0 && (
      <div class="sources" id="quellen">
        <h2>Quellen</h2>
        <ul>
          {d.sources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener nofollow">{s.label}</a></li>
          ))}
        </ul>
      </div>
    )}

      </div>
    </div>

    <div class="report">
      <p>
        <strong>Etwas stimmt nicht mehr?</strong> Preise, Öffnungszeiten und Reservierungsregeln
        ändern sich in China schnell. Schreib uns eine Zeile – wir prüfen es.
      </p>
      <a href={`mailto:${contactEmail}?subject=${encodeURIComponent('Korrektur: ' + d.title)}`}
        >Korrektur melden →</a
      >
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </article>
<script>
  // Video erst auf Klick laden: bis dahin geht kein Request an YouTube außer dem Vorschaubild.
  document.addEventListener('click', (ev) => {
    const target = ev.target as HTMLElement | null;
    const btn = target?.closest<HTMLButtonElement>('.v-thumb');
    if (!btn) return;
    const id = btn.dataset.play;
    if (!id) return;
    const frame = document.createElement('iframe');
    frame.className = 'v-frame';
    frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    frame.title = btn.getAttribute('aria-label') ?? 'Video';
    frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    frame.allowFullscreen = true;
    btn.replaceWith(frame);
  });
</script>
</Base>
